<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Text?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.example.foodorderingsystem.PresentationLayer.RestaurantController"
            prefHeight="600.0" prefWidth="900.0"
            stylesheets="@styles/main-styles.css">

    <!-- Top Navigation Bar -->
    <top>
        <VBox>
            <HBox styleClass="nav-bar" alignment="CENTER_LEFT" spacing="15.0">
                <HBox alignment="CENTER_LEFT" HBox.hgrow="ALWAYS">
                    <Label text="Wasly" style="-fx-font-size: 24px; -fx-text-fill: white; -fx-font-weight: bold;"/>
                </HBox>

                <HBox alignment="CENTER" spacing="10.0">
                    <Button fx:id="homeButton" text="Home" styleClass="nav-button" onAction="#handleHomeButton"/>
                    <Button fx:id="restaurantsButton" text="Restaurants" styleClass="nav-button" onAction="#handleRestaurantsButton"/>
                    <Button fx:id="ordersButton" text="My Orders" styleClass="nav-button" onAction="#handleOrdersButton"/>
                </HBox>

                <HBox alignment="CENTER_RIGHT" spacing="10.0" HBox.hgrow="ALWAYS">
                    <Button fx:id="cartButton" styleClass="nav-button" onAction="#handleCartButton">
                        <graphic>
                            <HBox spacing="5" alignment="CENTER">
                                <Label text="Cart" style="-fx-text-fill: white;"/>
                                <Label fx:id="cartItemCount" text="0" style="-fx-text-fill: white; -fx-background-color: rgba(255,255,255,0.2); -fx-padding: 2 6; -fx-background-radius: 10;"/>
                            </HBox>
                        </graphic>
                    </Button>
                    <Button fx:id="profileButton" text="Profile" styleClass="nav-button" onAction="#handleProfileButton"/>
                    <Button fx:id="logoutButton" text="Logout" styleClass="nav-button" onAction="#handleLogoutButton"/>
                </HBox>

                <padding>
                    <Insets left="20.0" right="20.0"/>
                </padding>
            </HBox>
        </VBox>
    </top>

    <!-- Main Content Area -->
    <center>
        <ScrollPane fitToWidth="true" style="-fx-background-color: transparent;">
            <VBox spacing="20" style="-fx-padding: 20;">
                <!-- Restaurant Header -->
                <HBox spacing="20" alignment="CENTER_LEFT">
                    <ImageView fx:id="restaurantImage" fitHeight="120" fitWidth="120" preserveRatio="true">
                        <Image url="@images/restaurant-placeholder.png"/>
                    </ImageView>

                    <VBox spacing="5">
                        <Label fx:id="restaurantNameLabel" text="Restaurant Name" styleClass="label-header"/>
                        <Label fx:id="restaurantAddressLabel" text="Restaurant Address"/>
                        <HBox spacing="10">
                            <Label fx:id="restaurantPhoneLabel" text="Phone: N/A"/>
                        </HBox>
                    </VBox>
                </HBox>

                <Separator/>

                <!-- Menu Categories Tabs -->
                <TabPane fx:id="categoriesTabPane" style="-fx-background-color: transparent;">
                    <!-- Tabs will be added programmatically -->
                </TabPane>
            </VBox>
        </ScrollPane>
    </center>

    <!-- Right Sidebar - Cart Summary -->
    <right>
        <VBox style="-fx-background-color: white; -fx-padding: 15; -fx-border-color: -light-gray; -fx-border-width: 0 0 0 1;"
             prefWidth="300" spacing="15">
            <Label text="Your Order" styleClass="label-header"/>

            <ScrollPane fx:id="cartScrollPane" VBox.vgrow="ALWAYS" style="-fx-background-color: transparent; -fx-max-height: 300;">
                <VBox fx:id="cartItemsContainer" spacing="10">
                    <!-- Cart items will be added here -->
                    <Label text="Your cart is empty" fx:id="emptyCartLabel"/>
                </VBox>
            </ScrollPane>

            <Separator/>

            <GridPane hgap="10" vgap="5">
                <columnConstraints>
                    <ColumnConstraints hgrow="SOMETIMES" />
                    <ColumnConstraints hgrow="SOMETIMES" halignment="RIGHT" />
                </columnConstraints>

                <Label text="Subtotal:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                <Label fx:id="subtotalLabel" text="$0.00" GridPane.columnIndex="1" GridPane.rowIndex="0" />

                <Label text="Delivery Fee:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                <Label fx:id="deliveryFeeLabel" text="$0.00" GridPane.columnIndex="1" GridPane.rowIndex="1" />

                <Label text="Total:" styleClass="label-subheader" GridPane.columnIndex="0" GridPane.rowIndex="2" />
                <Label fx:id="totalLabel" text="$0.00" styleClass="label-subheader" GridPane.columnIndex="1" GridPane.rowIndex="2" />
            </GridPane>

            <Button fx:id="checkoutButton" text="Proceed to Checkout" styleClass="button-accent"
                   prefWidth="Infinity" onAction="#handleCheckout" disable="true"/>
        </VBox>
    </right>

    <!-- Status Bar -->
    <bottom>
        <HBox style="-fx-background-color: -light-gray; -fx-padding: 5 20;">
            <Label text="© 2025 Wasly Food Ordering System" style="-fx-text-fill: -text-color;"/>
        </HBox>
    </bottom>
</BorderPane>
