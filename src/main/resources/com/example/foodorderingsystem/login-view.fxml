<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Text?>

<StackPane xmlns="http://javafx.com/javafx"
           xmlns:fx="http://javafx.com/fxml"
           fx:controller="com.example.foodorderingsystem.PresentationLayer.LoginController"
           prefHeight="600.0" prefWidth="900.0"
           stylesheets="@styles/main-styles.css">
    <VBox alignment="CENTER" spacing="20.0">
        <VBox styleClass="auth-container" alignment="CENTER" spacing="15.0">
            <Text styleClass="welcome-text" text="Welcome to Wasly"/>
            <Text text="Food Ordering System" styleClass="label-subheader"/>

            <Separator/>

            <Label text="Login to your account" styleClass="label-subheader"/>

            <TextField fx:id="emailField" promptText="Email" prefWidth="300.0"/>
            <PasswordField fx:id="passwordField" promptText="Password" prefWidth="300.0"/>

            <Button fx:id="loginButton" text="Login" onAction="#handleLogin" prefWidth="300.0"/>

            <HBox alignment="CENTER" spacing="5.0">
                <Label text="Don't have an account?"/>
                <Hyperlink fx:id="registerLink" text="Register" onAction="#handleRegisterLink"/>
            </HBox>

            <Label fx:id="errorMessage" textFill="RED" wrapText="true" visible="false"/>
        </VBox>

        <padding>
            <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
        </padding>
    </VBox>
</StackPane>
