<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="600.0" prefWidth="900.0" styleClass="background" stylesheets="@styles/main-styles.css"
            xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.foodorderingsystem.PresentationLayer.CartController">

    <!-- Top Navigation Bar -->
    <top>
        <VBox>
            <HBox styleClass="nav-bar" alignment="CENTER_LEFT" spacing="15.0">
                <HBox alignment="CENTER_LEFT" HBox.hgrow="ALWAYS">
                    <Label text="Wasly" style="-fx-font-size: 24px; -fx-text-fill: white; -fx-font-weight: bold;"/>
                </HBox>

                <HBox alignment="CENTER" spacing="10.0">
                    <Button fx:id="homeButton" text="Home" styleClass="nav-button" onAction="#handleHomeButton"/>
                    <Button fx:id="restaurantsButton" text="Restaurants" styleClass="nav-button" onAction="#handleRestaurantsButton"/>
                    <Button fx:id="ordersButton" text="My Orders" styleClass="nav-button" onAction="#handleOrdersButton"/>
                </HBox>

                <HBox alignment="CENTER_RIGHT" spacing="10.0" HBox.hgrow="ALWAYS">
                    <Button fx:id="cartButton" styleClass="nav-button" onAction="#handleCartButton">
                        <graphic>
                            <HBox spacing="5" alignment="CENTER">
                                <Label text="Cart" style="-fx-text-fill: white;"/>
                                <Label fx:id="cartItemCount" text="0" style="-fx-text-fill: white; -fx-background-color: rgba(255,255,255,0.2); -fx-padding: 2 6; -fx-background-radius: 10;"/>
                            </HBox>
                        </graphic>
                    </Button>
                    <Button fx:id="profileButton" text="Profile" styleClass="nav-button" onAction="#handleProfileButton"/>
                    <Button fx:id="logoutButton" text="Logout" styleClass="nav-button" onAction="#handleLogoutButton"/>
                </HBox>

                <padding>
                    <Insets left="20.0" right="20.0"/>
                </padding>
            </HBox>
        </VBox>
    </top>

    <!-- Main Content Area -->
    <center>
        <ScrollPane fitToWidth="true" style="-fx-background-color: transparent;">
            <VBox spacing="15" styleClass="content-pane">
                <!-- Cart Header -->
                <HBox spacing="10.0" styleClass="header">
                    <ImageView fitHeight="32.0" fitWidth="32.0" pickOnBounds="true" preserveRatio="true">
                        <Image url="@images/shopping-cart.svg" />
                    </ImageView>
                    <Label styleClass="header-text" text="Your Cart">
                        <font>
                            <Font name="System Bold" size="24.0" />
                        </font>
                    </Label>
                    <HBox.margin>
                        <Insets bottom="10.0" top="10.0" />
                    </HBox.margin>
                </HBox>

                <!-- Cart Info -->
                <HBox alignment="CENTER_LEFT" spacing="10.0">
                    <Label fx:id="cartItemsCountLabel" styleClass="cart-count-label" text="0 items in your cart" />
                    <Button fx:id="clearCartButton" mnemonicParsing="false" onAction="#onClearCartClicked" styleClass="danger-button" text="Clear Cart" />
                </HBox>

                <!-- Cart Items -->
                <HBox spacing="20">
                    <!-- Left side - Cart items table -->
                    <VBox spacing="15" HBox.hgrow="ALWAYS">
                        <StackPane VBox.vgrow="ALWAYS">
                            <ScrollPane fitToWidth="true" styleClass="transparent-scroll-pane" VBox.vgrow="ALWAYS">
                                <TableView fx:id="cartTableView" styleClass="cart-table">
                                    <columns>
                                        <TableColumn fx:id="imageColumn" prefWidth="80.0" text="Product" />
                                        <TableColumn fx:id="nameColumn" prefWidth="250.0" text="Name" />
                                        <TableColumn fx:id="priceColumn" prefWidth="120.0" text="Price" />
                                        <TableColumn fx:id="quantityColumn" prefWidth="100.0" text="Quantity" />
                                        <TableColumn fx:id="totalColumn" prefWidth="120.0" text="Total" />
                                        <TableColumn fx:id="actionColumn" prefWidth="120.0" text="Action" />
                                    </columns>
                                    <columnResizePolicy>
                                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                    </columnResizePolicy>
                                </TableView>
                            </ScrollPane>
                            <Label fx:id="emptyCartLabel" alignment="CENTER" styleClass="empty-cart-label" text="Your cart is empty" visible="false" StackPane.alignment="CENTER">
                                <font>
                                    <Font size="18.0" />
                                </font>
                            </Label>
                        </StackPane>
                    </VBox>

                    <!-- Right side - Order Summary and Checkout -->
                    <VBox spacing="15" minWidth="300" maxWidth="350" style="-fx-background-color: white; -fx-padding: 15; -fx-background-radius: 5;">
                        <Label text="Order Summary" styleClass="label-subheader"/>

                        <!-- Summary Details -->
                        <VBox spacing="10">
                            <HBox alignment="CENTER_LEFT" spacing="10.0">
                                <Label styleClass="summary-label" text="Subtotal:" HBox.hgrow="ALWAYS"/>
                                <Label fx:id="subtotalLabel" styleClass="summary-value" text=" " />
                            </HBox>
                            <HBox alignment="CENTER_LEFT" spacing="10.0">
                                <Label styleClass="summary-label" text="Delivery Fee:" HBox.hgrow="ALWAYS"/>
                                <Label fx:id="deliveryFeeLabel" styleClass="summary-value" text=" " />
                            </HBox>
                            <Separator/>
                            <HBox alignment="CENTER_LEFT" spacing="10.0">
                                <Label styleClass="summary-label-total" text="Total:" HBox.hgrow="ALWAYS"/>
                                <Label fx:id="totalLabel" styleClass="summary-value-total" text=" " />
                            </HBox>
                        </VBox>

                        <Separator/>

                        <!-- Checkout Section -->
                        <Label text="Delivery Information" styleClass="label-subheader"/>

                        <ComboBox fx:id="addressComboBox" promptText="Select delivery address" maxWidth="Infinity"/>
                        <Button text="Add New Address" fx:id="addAddressButton" onAction="#handleAddAddress"/>

                        <Label text="Delivery Instructions:"/>
                        <TextArea fx:id="deliveryInstructionsField" promptText="Optional instructions for delivery driver"
                                 prefHeight="60" wrapText="true"/>

                        <Separator/>

                        <Label text="Payment Method" styleClass="label-subheader"/>
                        <VBox spacing="10">
                            <RadioButton fx:id="cashRadioButton" text="Cash on Delivery" selected="true">
                                <toggleGroup>
                                    <ToggleGroup fx:id="paymentToggleGroup"/>
                                </toggleGroup>
                            </RadioButton>
                            <RadioButton fx:id="creditCardRadioButton" text="Credit Card" toggleGroup="$paymentToggleGroup"/>
                        </VBox>

                        <VBox fx:id="creditCardForm" spacing="10" visible="false">
                            <Separator/>
                            <TextField fx:id="cardNumberField" promptText="Card Number"/>
                            <TextField fx:id="cardNameField" promptText="Cardholder Name"/>
                            <HBox spacing="10">
                                <TextField fx:id="expiryDateField" promptText="Expiry Date (MM/YY)" HBox.hgrow="ALWAYS"/>
                                <TextField fx:id="cvvField" promptText="CVV" prefWidth="70"/>
                            </HBox>
                        </VBox>

                        <Separator/>

                        <!-- Action Buttons -->
                        <HBox spacing="10">
                            <Button fx:id="continueShoppingButton" mnemonicParsing="false" onAction="#onContinueShoppingClicked"
                                   styleClass="secondary-button" text="Continue Shopping" HBox.hgrow="ALWAYS">
                                <effect>
                                    <DropShadow height="4.0" radius="1.5" width="4.0" />
                                </effect>
                            </Button>
                            <Button fx:id="placeOrderButton" mnemonicParsing="false" onAction="#handlePlaceOrder"
                                   styleClass="primary-button" text="Place Order" HBox.hgrow="ALWAYS">
                                <effect>
                                    <DropShadow height="4.0" radius="1.5" width="4.0" />
                                </effect>
                            </Button>
                        </HBox>
                    </VBox>
                </HBox>

                <padding>
                    <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
                </padding>
            </VBox>
        </ScrollPane>
    </center>

    <!-- Status Bar -->
    <bottom>
        <HBox style="-fx-background-color: -light-gray; -fx-padding: 5 20;">
            <Label text="© 2025 Wasly Food Ordering System" style="-fx-text-fill: -text-color;"/>
        </HBox>
    </bottom>
</BorderPane>
