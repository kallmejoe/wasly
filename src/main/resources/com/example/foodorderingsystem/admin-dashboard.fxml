<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="600.0" minWidth="800.0" prefHeight="768.0" prefWidth="1024.0" stylesheets="@styles/admin-dashboard.css" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.foodorderingsystem.PresentationLayer.AdminDashboardController">
    <left>
        <VBox id="sidebar" prefHeight="600.0" prefWidth="180.0" spacing="10.0" BorderPane.alignment="CENTER">
            <children>
                <Label id="brand" prefHeight="50.0" text="Food Ordering">
                    <font>
                        <Font name="System Bold" size="18.0" />
                    </font>
                    <VBox.margin>
                        <Insets />
                    </VBox.margin>
                    <padding>
                        <Insets left="10.0" />
                    </padding>
                </Label>
                <Separator prefWidth="200.0" />
                <Button fx:id="btnRestaurants" mnemonicParsing="false" onAction="#handleRestaurants" prefHeight="40.0" prefWidth="200.0" styleClass="nav-button" text="Restaurants" />
                <Button fx:id="btnProducts" mnemonicParsing="false" onAction="#handleProducts" prefHeight="40.0" prefWidth="200.0" styleClass="nav-button" text="Products" />
                <Button fx:id="btnCategories" mnemonicParsing="false" onAction="#handleCategories" prefHeight="40.0" prefWidth="200.0" styleClass="nav-button" text="Categories" />
                <Button fx:id="btnCustomers" mnemonicParsing="false" onAction="#handleCustomers" prefHeight="40.0" prefWidth="200.0" styleClass="nav-button" text="Customers" />
                <Button fx:id="btnOrders" mnemonicParsing="false" onAction="#handleOrders" prefHeight="40.0" prefWidth="200.0" styleClass="nav-button" text="Orders" />
                <Button fx:id="btnDeliveries" mnemonicParsing="false" onAction="#handleDeliveries" prefHeight="40.0" prefWidth="200.0" styleClass="nav-button" text="Deliveries" />
                <Button fx:id="btnPayments" mnemonicParsing="false" onAction="#handlePayments" prefHeight="40.0" prefWidth="200.0" styleClass="nav-button" text="Payments" />
                <Button fx:id="btnAdmins" mnemonicParsing="false" onAction="#handleAdmins" prefHeight="40.0" prefWidth="200.0" styleClass="nav-button" text="Admins" />
                <VBox VBox.vgrow="ALWAYS" />
                <Button fx:id="btnLogout" layoutX="10.0" layoutY="303.0" mnemonicParsing="false" onAction="#handleLogout" prefHeight="40.0" prefWidth="200.0" styleClass="nav-button, logout-button" text="Logout" />
            </children>
            <BorderPane.margin>
                <Insets />
            </BorderPane.margin>
            <padding>
                <Insets top="10.0" />
            </padding>
        </VBox>
    </left>
    <center>
        <BorderPane fx:id="contentArea" prefHeight="200.0" prefWidth="200.0" BorderPane.alignment="CENTER">
            <top>
                <HBox alignment="CENTER_LEFT" prefHeight="60.0" prefWidth="200.0" spacing="20.0" BorderPane.alignment="CENTER">
                    <children>
                        <Label fx:id="contentTitle" styleClass="content-title" text="Dashboard">
                            <font>
                                <Font size="24.0" />
                            </font>
                        </Label>
                        <HBox fx:id="actionButtons" alignment="CENTER_RIGHT" visible="false" HBox.hgrow="ALWAYS">
                            <children>
                                <Button fx:id="btnRefresh" mnemonicParsing="false" onAction="#handleRefresh" styleClass="action-button, refresh-button" text="Refresh" />
                                <Button fx:id="btnAdd" mnemonicParsing="false" onAction="#handleAdd" styleClass="action-button, add-button" text="Add New" />
                            </children>
                        </HBox>
                    </children>
                    <padding>
                        <Insets left="20.0" right="20.0" />
                    </padding>
                </HBox>
            </top>
            <center>
                <StackPane BorderPane.alignment="CENTER">
                    <children>
                        <!-- Welcome screen - shown when no section is selected -->
                        <VBox fx:id="welcomeScreen" alignment="CENTER" spacing="20.0">
                            <children>
                                <Label text="Welcome to Admin Dashboard" styleClass="welcome-header">
                                    <font>
                                        <Font size="24.0" />
                                    </font>
                                </Label>
                                <Label text="Select a category from the sidebar to get started" styleClass="welcome-subheader" />
                            </children>
                        </VBox>

                        <!-- Restaurants container -->
                        <ScrollPane fx:id="restaurantsContainer" fitToWidth="true" managed="false" visible="false">
                            <content>
                                <FlowPane fx:id="restaurantsPane" hgap="15.0" vgap="15.0" styleClass="card-container">
                                    <padding>
                                        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
                                    </padding>
                                </FlowPane>
                            </content>
                        </ScrollPane>

                        <!-- Products container -->
                        <ScrollPane fx:id="productsContainer" fitToWidth="true" managed="false" visible="false">
                            <content>
                                <FlowPane fx:id="productsPane" hgap="15.0" vgap="15.0" styleClass="card-container">
                                    <padding>
                                        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
                                    </padding>
                                </FlowPane>
                            </content>
                        </ScrollPane>

                        <!-- Categories container -->
                        <ScrollPane fx:id="categoriesContainer" fitToWidth="true" managed="false" visible="false">
                            <content>
                                <FlowPane fx:id="categoriesPane" hgap="15.0" vgap="15.0" styleClass="card-container">
                                    <padding>
                                        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
                                    </padding>
                                </FlowPane>
                            </content>
                        </ScrollPane>

                        <!-- Customers container -->
                        <ScrollPane fx:id="customersContainer" fitToWidth="true" managed="false" visible="false">
                            <content>
                                <FlowPane fx:id="customersPane" hgap="15.0" vgap="15.0" styleClass="card-container">
                                    <padding>
                                        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
                                    </padding>
                                </FlowPane>
                            </content>
                        </ScrollPane>

                        <!-- Orders container -->
                        <ScrollPane fx:id="ordersContainer" fitToWidth="true" managed="false" visible="false">
                            <content>
                                <FlowPane fx:id="ordersPane" hgap="15.0" vgap="15.0" styleClass="card-container">
                                    <padding>
                                        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
                                    </padding>
                                </FlowPane>
                            </content>
                        </ScrollPane>

                        <!-- Deliveries container -->
                        <ScrollPane fx:id="deliveriesContainer" fitToWidth="true" managed="false" visible="false">
                            <content>
                                <FlowPane fx:id="deliveriesPane" hgap="15.0" vgap="15.0" styleClass="card-container">
                                    <padding>
                                        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
                                    </padding>
                                </FlowPane>
                            </content>
                        </ScrollPane>

                        <!-- Payments container -->
                        <ScrollPane fx:id="paymentsContainer" fitToWidth="true" managed="false" visible="false">
                            <content>
                                <FlowPane fx:id="paymentsPane" hgap="15.0" vgap="15.0" styleClass="card-container">
                                    <padding>
                                        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
                                    </padding>
                                </FlowPane>
                            </content>
                        </ScrollPane>

                        <!-- Admins container -->
                        <ScrollPane fx:id="adminsContainer" fitToWidth="true" managed="false" visible="false">
                            <content>
                                <FlowPane fx:id="adminsPane" hgap="15.0" vgap="15.0" styleClass="card-container">
                                    <padding>
                                        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
                                    </padding>
                                </FlowPane>
                            </content>
                        </ScrollPane>
                    </children>
                </StackPane>
            </center>
            <bottom>
                <HBox alignment="CENTER_LEFT" prefHeight="40.0" prefWidth="200.0" BorderPane.alignment="CENTER">
                    <children>
                        <Label fx:id="statusLabel" text="Ready" HBox.hgrow="ALWAYS">
                            <HBox.margin>
                                <Insets left="20.0" />
                            </HBox.margin>
                        </Label>
                        <Label fx:id="lblItemCount" text="Total Items: 0">
                            <HBox.margin>
                                <Insets right="20.0" />
                            </HBox.margin>
                        </Label>
                    </children>
                </HBox>
            </bottom>
        </BorderPane>
    </center>
</BorderPane>
