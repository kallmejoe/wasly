<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Text?>

<StackPane xmlns="http://javafx.com/javafx"
           xmlns:fx="http://javafx.com/fxml"
           fx:controller="com.example.foodorderingsystem.PresentationLayer.RegisterController"
           prefHeight="600.0" prefWidth="900.0"
           stylesheets="@styles/main-styles.css">
    <ScrollPane fitToWidth="true" fitToHeight="true" style="-fx-background-color: transparent;">
        <VBox alignment="CENTER" spacing="20.0">
            <VBox styleClass="auth-container" alignment="CENTER" spacing="15.0">
                <Text styleClass="welcome-text" text="Create Account"/>
                <Text text="Join Wasly Food Ordering System" styleClass="label-subheader"/>

                <Separator/>

                <GridPane hgap="10" vgap="10">
                    <columnConstraints>
                        <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="145.0" />
                        <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="145.0" />
                    </columnConstraints>

                    <TextField fx:id="firstNameField" promptText="First Name"
                              GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                    <TextField fx:id="lastNameField" promptText="Last Name"
                              GridPane.columnIndex="1" GridPane.rowIndex="0"/>

                    <TextField fx:id="middleNameField" promptText="Middle Name (Optional)"
                              GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                    <TextField fx:id="phoneField" promptText="Phone Number"
                              GridPane.columnIndex="1" GridPane.rowIndex="1"/>

                    <TextField fx:id="emailField" promptText="Email"
                              GridPane.columnIndex="0" GridPane.columnSpan="2" GridPane.rowIndex="2"/>

                    <PasswordField fx:id="passwordField" promptText="Password"
                                  GridPane.columnIndex="0" GridPane.rowIndex="3"/>
                    <PasswordField fx:id="confirmPasswordField" promptText="Confirm Password"
                                  GridPane.columnIndex="1" GridPane.rowIndex="3"/>

                    <Label text="Address Information" styleClass="label-subheader"
                          GridPane.columnIndex="0" GridPane.columnSpan="2" GridPane.rowIndex="4"/>

                    <TextField fx:id="cityField" promptText="City"
                              GridPane.columnIndex="0" GridPane.rowIndex="5"/>
                    <TextField fx:id="streetField" promptText="Street"
                              GridPane.columnIndex="1" GridPane.rowIndex="5"/>

                    <TextField fx:id="buildingField" promptText="Building/Apartment No."
                              GridPane.columnIndex="0" GridPane.rowIndex="6"/>
                </GridPane>

                <Button fx:id="registerButton" text="Register" onAction="#handleRegister"
                       prefWidth="300.0" styleClass="button-accent"/>

                <HBox alignment="CENTER" spacing="5.0">
                    <Label text="Already have an account?"/>
                    <Hyperlink fx:id="loginLink" text="Login" onAction="#handleLoginLink"/>
                </HBox>

                <Label fx:id="errorMessage" textFill="RED" wrapText="true" visible="false"/>
            </VBox>

            <padding>
                <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
            </padding>
        </VBox>
    </ScrollPane>
</StackPane>
